# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SingPay Gateway Integration (configurer les variables dans l'environnement serveur / Netlify)
SINGPAY_CLIENT_ID=""
SINGPAY_CLIENT_SECRET=""
SINGPAY_WALLET_ID=""
SINGPAY_API_URL=""
SINGPAY_WEBHOOK_URL=""

# Card Issuing Provider (partenaire émetteur de cartes virtuelles — côté serveur uniquement)
CARD_ISSUER_API_URL=""
CARD_ISSUER_API_KEY=""
CARD_ISSUER_WEBHOOK_SECRET=""

# Firebase Admin SDK (pour Netlify Functions et scripts serveur)
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT=""
